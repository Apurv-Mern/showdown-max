# =============================================================================
# Development overrides — loaded by `npm run dev`.
# Values here take precedence over `.env`.
# =============================================================================

NODE_ENV=development

# Client (Next.js public env — must be present at build time)
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_SOCKET_URL=http://localhost:5001

# CORS — comma-separated list. Leave commented to use the defaults
# in `server/src/config/cors.js` (localhost:5003).
# ALLOWED_ORIGINS=http://localhost:5003,http://127.0.0.1:5003
