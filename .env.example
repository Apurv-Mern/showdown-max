# MySQL (local)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=showdown_trivia
DB_USER=root
DB_PASSWORD=
DB_SYNC_ALTER=false

# Redis (local: redis-server)
REDIS_URL=redis://localhost:6379

# Server
PORT=5001

# Client
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_SOCKET_URL=http://localhost:5001

# Auth
JWT_SECRET=change_me_to_a_random_64_char_string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@showdown.com
ADMIN_PASSWORD=admin123
HOST_EMAIL=host@showdown.com
HOST_PASSWORD=host123

# Media (local for dev; S3 for prod)
UPLOAD_DIR=./uploads
