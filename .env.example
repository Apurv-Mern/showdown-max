# =============================================================================
# Showdown Trivia — env reference
#
# This project uses three root-level env files:
#   1. `.env`              — shared base (DB, Redis, JWT, admin creds, PORT)
#   2. `.env.development`  — dev overrides   (NODE_ENV + localhost URLs)
#   3. `.env.production`   — prod overrides  (NODE_ENV + showdowntrivia.24livehost.com URLs)
#
# Scripts (run from the repo root):
#   npm run dev         -> loads `.env.development` + `.env`, starts client+server in dev
#   npm run build:prod  -> loads `.env.production`  + `.env`, builds client with prod URLs baked in
#   npm run start:prod  -> loads `.env.production`  + `.env`, starts client+server in prod
# =============================================================================

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=showdown_trivia
DB_USER=root
DB_PASSWORD=
DB_SYNC_ALTER=false

# ---- Redis (local: `redis-server`) ----
REDIS_URL=redis://localhost:6379

# ---- Server ----
PORT=5001

# ---- Auth ----
JWT_SECRET=change_me_to_a_random_64_char_string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@showdown.com
ADMIN_PASSWORD=admin123
HOST_EMAIL=host@showdown.com
HOST_PASSWORD=host123

# ---- Media (local for dev; S3 for prod) ----
UPLOAD_DIR=./uploads

# ---- Client public URLs (override per env in .env.development / .env.production) ----
# NEXT_PUBLIC_API_URL=http://localhost:5001
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5001

# ---- CORS ----
# Optional comma-separated allow-list. Leave unset to use the per-NODE_ENV
# defaults in `server/src/config/cors.js`.
# ALLOWED_ORIGINS=http://localhost:5003,https://showdowntrivia.24livehost.com
